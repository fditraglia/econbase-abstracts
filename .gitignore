# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Per-machine Claude Code settings
.claude/settings.local.json

# Generated data and outputs
# (parquet files are now tracked via Git LFS)
cluster_papers.html

# Experiment intermediates — regenerate with experiments/*.py
experiments/*.npy
experiments/intro_embeddings.parquet
experiments/report_pairs.csv
experiments/*.log
experiments/embedding-experiment.html
experiments/embedding-experiment_files/

# incremental refresh scratch (regenerates; see refresh_embeddings.py)
.refresh_cache.parquet
*.parquet.tmp

# Describes the local embeddings file, so it must travel with the data rather than
# the code: a manifest committed ahead of its parquet would tell a fresh clone that
# papers it does not have were already fetched.
embeddings_manifest.json

# The 4096-dimensional vectors. The app reads similarity_top100.parquet instead, so
# these are needed only for analysis and for rebuilding that table. Canonical copy:
#   gs://econbase-embeddings/econ_em_embeddings.parquet  (pointer: current.json)
econ_em_embeddings.parquet

# Per-unit rows behind the citation-vs-embedding report. Regenerate with
# experiments/compare_citation_embedding.py; the rendered HTML is self-contained.
experiments/comparison_paper_level.csv
experiments/comparison_author_level.csv
experiments/comparison_pairs.csv
